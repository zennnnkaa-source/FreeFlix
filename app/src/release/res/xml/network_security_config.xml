<?xml version="1.0" encoding="utf-8"?>
<!-- RELEASE overlay. The VPS has no domain, so its TLS cert is self-signed for
     the bare IP and no public CA vouches for it. OkHttp's CertificatePinner
     (AuthConfig.CERT_PIN) only *narrows* which certs are acceptable once a chain
     already validates — it cannot establish trust on its own, so without this
     trust anchor every release HTTPS call would fail the platform check before
     the pin was ever consulted. Scoped to the one IP: everything else keeps the
     system anchors, and cleartext stays off everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">66.154.107.27</domain>
        <trust-anchors>
            <certificates src="@raw/nuvola_vps" />
        </trust-anchors>
    </domain-config>
</network-security-config>
