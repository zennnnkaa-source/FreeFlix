<?xml version="1.0" encoding="utf-8"?>
<!--
  Nepdon Wire type.

  Sora        display  - screen titles, the wordmark, big numbers
  Manrope     body/UI  - labels, rows, buttons
  JetBrains   mono     - DIAGNOSTICS ONLY: the DIAG block, hex, counters

  The mono face is reserved on purpose. When a number is monospaced in this
  product it means "this came off the wire", and that distinction is worth
  more than the typographic variety.

  Fonts are bundled under res/font - there is no network at runtime.
-->
<resources>

    <style name="TextAppearance.Nv" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/nv_body</item>
        <item name="android:textColor">@color/nv_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Nv.Body">
        <item name="android:textSize">@dimen/nv_text_body</item>
    </style>

    <style name="TextAppearance.Nv.Label">
        <item name="android:textSize">@dimen/nv_text_label</item>
        <item name="android:textColor">@color/nv_text_2</item>
    </style>

    <!-- Section headers. Upper case is applied in the layout, not baked
         into the string, so translations stay translatable. -->
    <style name="TextAppearance.Nv.Micro">
        <item name="android:textSize">@dimen/nv_text_micro</item>
        <item name="android:textColor">@color/nv_text_3</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
