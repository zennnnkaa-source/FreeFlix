<?xml version="1.0" encoding="utf-8"?>
<!--
    What is left of the pre-Nepdon Wire widget styles.

    Twenty-three styles were declared here and referenced by NOTHING: the whole
    Widget.FL.* family, six of the eight TextAppearance.FL.* sizes, both
    ModernSwitch variants. They are the residue of layouts that the Nepdon Wire
    rebuild replaced - aapt compiles an unreferenced style without complaint, so
    nothing ever pointed at them. Deleted 2026-09-16; the theme itself and the
    one surviving text appearance are below.
-->
<resources>

    <!-- The NAME "AppTheme" must survive: AndroidManifest.xml references it.
         Repointed to Theme.Nepdon 2026-09-16. -->
    <style name="AppTheme" parent="Theme.Nepdon" />

    <!--
        Android infers a parent from dot notation, so "TextAppearance.FL.Mono"
        needs "TextAppearance.FL" to exist. This empty base anchors the naming
        tree; without it aapt fails with "resource style/... not found".
    -->
    <style name="TextAppearance.FL" parent="" />

    <!-- Telemetry. Monospace so columns line up between frames. -->
    <style name="TextAppearance.FL.Mono">
        <item name="android:textSize">@dimen/fl_text_mono</item>
        <item name="android:textColor">@color/fl_mono_label</item>
        <item name="android:fontFamily">monospace</item>
    </style>

</resources>
