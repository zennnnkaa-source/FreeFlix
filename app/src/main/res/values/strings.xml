<?xml version="1.0" encoding="utf-8"?>
<!--
  NEPDON WIRE strings.

  Renamed from "SunnyMod - Fake Lag" and translated out of the Vietnamese the
  original fork shipped. EVERY NAME IS UNCHANGED - only the values moved, so
  no layout or Java reference breaks.

  The package id deliberately stays com.nepdon.wire: renaming it would
  move SharedPreferences to a new file and destroy all 107 persisted settings
  on the device. The label changes; the id must not.
-->
