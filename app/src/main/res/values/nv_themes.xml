<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme.Nepdon. The app is dark-only by design: it is used over a game, at
  night, and a light variant would be a second full design nobody would open.
  There is no values-night/ and that is deliberate, not an omission.
-->
<resources>
    <style name="Theme.Nepdon" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/nv_ground</item>
        <item name="android:windowBackground">@color/nv_ground</item>
        <item name="android:textColorPrimary">@color/nv_text</item>
        <item name="android:textColorSecondary">@color/nv_text_2</item>
        <item name="android:textColorHint">@color/nv_text_3</item>
        <item name="android:colorAccent">@color/nv_teal</item>
        <item name="android:colorPrimary">@color/nv_blue_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/nv_ground</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fontFamily">@font/nv_body</item>
    </style>

    <!--
      Dialogs. Without this the app picker renders as a raw grey system
      AlertDialog in the middle of a dark teal app, with a system-localised
      "Cancel" that comes back in whatever language the PHONE is set to -
      which is how Vietnamese survived the rename.
    -->
    <style name="Theme.Nepdon.Dialog" parent="android:Theme.Material.Dialog">
        <item name="android:colorBackground">@color/nv_surface</item>
        <item name="android:windowBackground">@color/nv_surface</item>
        <item name="android:textColorPrimary">@color/nv_text</item>
        <item name="android:textColorSecondary">@color/nv_text_2</item>
        <item name="android:colorAccent">@color/nv_teal</item>
        <item name="android:fontFamily">@font/nv_body</item>
    </style>
</resources>
