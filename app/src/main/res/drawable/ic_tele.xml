<?xml version="1.0" encoding="utf-8"?>
<!--
    TELEPORT. A pad seen in perspective with an arrow dropping into it, and two
    motion dashes flanking the shaft.

    Chosen over a "portal ring" because the feature rewrites the position you
    REPORT — you arrive somewhere — and an arrow landing on a pad says arrival
    at 22dp, where a ring alone reads as a generic circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The pad. rx 8.4, not 7.2: at 7.2 this filled 60% of the viewport
         against the snowflake's 72% and read visibly smaller in the same
         button. Measured off a screenshot, not judged by eye. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:pathData="M12,15.2
                          a8.4,3.6 0 1 0 0,7.2
                          a8.4,3.6 0 1 0 0,-7.2
                          Z" />

    <!-- The shaft and its head. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,2.2 V13.2" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.5,9.2 L12,13.7 L16.5,9.2" />

    <!-- Motion dashes: the "you were not here a moment ago" cue. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M5.6,4.0 V7.6 M18.4,4.0 V7.6" />
</vector>
