<?xml version="1.0" encoding="utf-8"?>
<!--
    FREEZE. A six-spoke snowflake with barbs, drawn as STROKES rather than a
    filled outline: at the ~22dp the overlay button renders it, a filled
    snowflake's arms collapse into a blob, while a 1.6 unit round-capped stroke
    stays legible over gameplay.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The three axes through the centre: vertical, and two at +/-60 degrees. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M12,2.4 V21.6" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M3.7,7.2 L20.3,16.8" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M3.7,16.8 L20.3,7.2" />

    <!-- Barbs. Two pairs per axis, near the tip and mid-arm. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M12,5.4 L9.7,3.1 M12,5.4 L14.3,3.1
                          M12,18.6 L9.7,20.9 M12,18.6 L14.3,20.9" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M6.5,10.4 L6.0,7.2 M6.5,10.4 L3.3,9.9
                          M17.5,13.6 L18.0,16.8 M17.5,13.6 L20.7,14.1" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M6.5,13.6 L3.3,14.1 M6.5,13.6 L6.0,16.8
                          M17.5,10.4 L20.7,9.9 M17.5,10.4 L18.0,7.2" />
</vector>
