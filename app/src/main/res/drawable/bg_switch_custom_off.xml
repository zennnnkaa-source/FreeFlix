<?xml version="1.0" encoding="utf-8"?>
<!-- Nepdon Wire switch, OFF. See bg_switch_custom_on.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nv_raised"/>
            <corners android:radius="999dp"/>
            <stroke android:width="1dp" android:color="@color/nv_line_strong"/>
        </shape>
    </item>
    <item android:gravity="center_vertical|left" android:left="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/nv_text_3"/>
            <size android:width="22dp" android:height="22dp"/>
        </shape>
    </item>
</layer-list>
