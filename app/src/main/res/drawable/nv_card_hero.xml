<?xml version="1.0" encoding="utf-8"?>
<!--
  The PRIMARY action. The brand gradient moved here from the "Change" button:
  the screen's most important control was a flat card with a hairline border
  while a secondary one carried the only gradient on the page, which inverted
  the hierarchy. Moving it also removed a 3.35:1 white-on-teal contrast
  failure on the button that gave it up.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="@color/nv_blue_deep"
        android:endColor="@color/nv_teal_deep"
        android:angle="45"
        android:type="linear"/>
    <corners android:radius="@dimen/nv_radius_panel"/>
</shape>
