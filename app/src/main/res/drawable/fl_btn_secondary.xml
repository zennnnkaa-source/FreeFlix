<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fl_accent_muted"/>
            <corners android:radius="@dimen/fl_radius_md"/>
            <stroke android:width="@dimen/fl_stroke_hairline" android:color="@color/fl_accent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fl_bg_surface_high"/>
            <corners android:radius="@dimen/fl_radius_md"/>
            <stroke android:width="@dimen/fl_stroke_hairline" android:color="@color/fl_outline_strong"/>
        </shape>
    </item>
</selector>
