<?xml version="1.0" encoding="utf-8"?>
<!--
    SYSTEM tab. A gear.

    Permissions, button sizing and developer mode: the page is settings, and a
    gear is the one symbol nobody has to learn.

    THE FIRST VERSION OF THIS READ AS A SUN. Its teeth were short strokes
    radiating from the centre, starting well INSIDE the ring, so at 22dp the eye
    saw a circle surrounded by detached rays. Teeth have to touch the rim: each
    one now starts at r=5.9 (just inside the 5.4 ring's 2.4-wide stroke, so they
    merge) and runs out to r=9.2, thicker than the ring so they read as mass
    rather than as lines.

    The hub is left open by the ring being a stroke, not a fill - no winding
    trick needed here, unlike ic_ghost.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The rim. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:pathData="M12,6.6
                          a5.4,5.4 0 1 0 0,10.8
                          a5.4,5.4 0 1 0 0,-10.8
                          Z" />

    <!-- Eight teeth, every 45 degrees, overlapping the rim. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.9"
        android:strokeLineCap="butt"
        android:pathData="M12,6.1 V2.8
                          M12,17.9 V21.2
                          M6.1,12 H2.8
                          M17.9,12 H21.2" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="butt"
        android:pathData="M7.83,7.83 L5.5,5.5
                          M16.17,16.17 L18.5,18.5
                          M16.17,7.83 L18.5,5.5
                          M7.83,16.17 L5.5,18.5" />
</vector>
