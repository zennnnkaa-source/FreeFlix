<?xml version="1.0" encoding="utf-8"?>
<!--
  Nepdon Wire launcher background: the icon's own gradient, corner to corner.
  Vector, not a bitmap, so it stays clean at every mask size and adds
  nothing to the APK. Colours measured from the source render:
  #2442A4 bottom-left, #12A8A7 top-right.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0" android:startY="108"
                android:endX="108" android:endY="0"
                android:type="linear">
                <item android:offset="0" android:color="#FF7F1D1D"/>
                <item android:offset="1" android:color="#FFEF4444"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
