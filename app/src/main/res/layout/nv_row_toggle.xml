<?xml version="1.0" encoding="utf-8"?>
<!--
  A toggle row. NOT included by <include> - kept as the reference for the
  shape every toggle row in activity_main.xml repeats, so the pattern is
  stated once even though the ids force it to be written out.

  The switch is a TextView because UiBindings binds it as one and swaps its
  background between bg_switch_custom_on/off. Height 48dp is the touch floor.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="@dimen/nv_touch_min"
    android:paddingLeft="@dimen/nv_space_4"
    android:paddingRight="@dimen/nv_space_3"
    android:paddingTop="@dimen/nv_space_2"
    android:paddingBottom="@dimen/nv_space_2">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Nv.Body"
            android:text="Label"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Nv.Micro"
            android:letterSpacing="0"
            android:textStyle="normal"
            android:text="Status"/>
    </LinearLayout>

    <TextView
        android:layout_width="52dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_switch_custom_off"/>

</LinearLayout>
