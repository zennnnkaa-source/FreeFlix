<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY. Permits cleartext to the adb-reversed local dev server
     (adb reverse tcp:8777 tcp:8777) so the login flow can be tested without
     TLS. Release builds have no such config and use HTTPS + cert pinning. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
